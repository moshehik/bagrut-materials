# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# lesson-materials working files (not part of the site) - everything ignored
# EXCEPT the two tracking/instructions logs below, which are plain text and
# benefit from real git history (no docx/PDF deliverables or scratch/cache
# files are tracked - see CLAUDE.md "Content authoring")
/חומרים מוכנים מחדש/*
!/חומרים מוכנים מחדש/הוראות לבניית כל החומרים החדשים/
/חומרים מוכנים מחדש/הוראות לבניית כל החומרים החדשים/*
!/חומרים מוכנים מחדש/הוראות לבניית כל החומרים החדשים/כל ההוראות לבניית החומרים.md
!/חומרים מוכנים מחדש/הוראות לבניית כל החומרים החדשים/יומן תיקונים מבני (סטטוס קבצים).md

# standalone content-authoring CLI tools (isolated from the site's own deps)
/_tools/node_modules
/_tools/package-lock.json

# ad-hoc content-authoring scratch files (dumps/caches/one-off build scripts
# used while hand-writing lesson materials — see CLAUDE.md "Content authoring")
/_*.js
/_*.mjs
/_*.json
/_*.xml
/_*.txt
/_tmp/
/_tmp_*
/_render_temp_ch*/
/scratch_*/
/scratchpad_*/
/_scratch_*/
/_scratchpad_*/
/_*_build_*/
